---
import { buildProjection } from '../lib/cuba';
import { farmUrl, type FarmEntry } from '../lib/farms';

/**
 * Carte interactive de Cuba.
 * - Silhouette vectorielle stylisée (contours épais, couleurs naturelles),
 *   « flottant » sans encadré.
 * - Un marqueur par ferme, positionné automatiquement depuis ses coordonnées
 *   GPS via la projection partagée `buildProjection`.
 * - Un chemin pointillé relie les fermes dans l'ordre du parcours.
 * - Survol/focus : nom + résumé. Clic : ouverture de la fiche.
 *
 * Les marqueurs sont des éléments HTML superposés à la carte SVG et
 * positionnés en pourcentage : ils restent alignés à toute taille d'écran.
 */
interface Props {
  farms: FarmEntry[];
}
const { farms } = Astro.props;

const { project, outlinePath, width, height } = buildProjection({ width: 1000 });

// Points projetés pour chaque ferme (en unités du viewBox).
const points = farms.map((farm) => {
  const p = project(farm.data.lon, farm.data.lat);
  return {
    farm,
    x: p.x,
    y: p.y,
    leftPct: (p.x / width) * 100,
    topPct: (p.y / height) * 100,
  };
});

// Chemin reliant les fermes dans l'ordre.
const routePath = points
  .map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`)
  .join(' ');

// Repère de la capitale : La Havane (point de référence, non cliquable).
const havana = project(-82.3666, 23.1136);
const havanaPos = {
  leftPct: (havana.x / width) * 100,
  topPct: (havana.y / height) * 100,
};
---

<div class="map" style={`--map-ratio:${(height / width) * 100}%`}>
  <svg
    class="map__svg"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label="Carte de Cuba situant les fermes visitées"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <linearGradient id="islandFill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#a9bd9d" />
        <stop offset="100%" stop-color="#7c9670" />
      </linearGradient>
      <filter id="islandShadow" x="-20%" y="-20%" width="140%" height="160%">
        <feDropShadow
          dx="0"
          dy="10"
          stdDeviation="14"
          flood-color="#2c3d26"
          flood-opacity="0.18"
        />
      </filter>
    </defs>

    <!-- Silhouette de Cuba : remplissage vert, bordure noire simple -->
    <path
      d={outlinePath}
      fill="url(#islandFill)"
      stroke="#141414"
      stroke-width="3.5"
      stroke-linejoin="round"
      filter="url(#islandShadow)"
    />

    <!-- Chemin reliant les fermes -->
    {
      points.length > 1 && (
        <path
          class="map__route"
          d={routePath}
          fill="none"
          stroke="#d15000"
          stroke-width="3"
          stroke-linecap="round"
          stroke-dasharray="2 10"
        />
      )
    }
  </svg>

  <!-- Repère de la capitale : La Havane -->
  <div
    class="city"
    style={`left:${havanaPos.leftPct}%; top:${havanaPos.topPct}%`}
  >
    <span class="city__dot" aria-hidden="true"></span>
    <span class="city__label">La Havane</span>
  </div>

  <!-- Marqueurs (HTML superposé, alignés en %) -->
  <ul class="map__markers">
    {
      points.map(({ farm, leftPct, topPct }, i) => (
        <li
          class="marker"
          style={`left:${leftPct}%; top:${topPct}%`}
        >
          <a
            class="marker__hit"
            href={farmUrl(farm)}
            aria-label={`${farm.data.name}${farm.data.summary ? ' — ' + farm.data.summary : ''}`}
          >
            <span class="marker__pin" aria-hidden="true">
              <span class="marker__index">{i + 1}</span>
            </span>
            <span class="marker__pulse" aria-hidden="true" />
            <span class="marker__tooltip" role="tooltip">
              <span class="marker__name">{farm.data.name}</span>
              {farm.data.summary && (
                <span class="marker__summary">{farm.data.summary}</span>
              )}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .map {
    position: relative;
    width: 100%;
    max-width: 1150px;
    margin-inline: auto;
  }
  /* Réserve la hauteur selon le ratio réel de l'île (évite les sauts). */
  .map::before {
    content: '';
    display: block;
    padding-top: var(--map-ratio);
  }
  .map__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .map__route {
    animation: routeDraw 30s linear infinite;
  }
  @keyframes routeDraw {
    to {
      stroke-dashoffset: -240;
    }
  }

  /* Repère capitale ---------------------------------------------------- */
  .city {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 0;
    height: 0;
    pointer-events: none;
    z-index: 1;
  }
  .city__dot {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #fff;
    border: 2.5px solid #141414;
  }
  /* Étiquette à gauche du point (à l'opposé des marqueurs de fermes). */
  .city__label {
    position: absolute;
    top: 0;
    left: -10px;
    transform: translate(-100%, -50%);
    font-size: 0.72rem;
    font-weight: 700;
    color: #141414;
    background: color-mix(in srgb, var(--beige-50) 82%, transparent);
    padding: 1px 6px;
    border-radius: 6px;
    white-space: nowrap;
  }

  /* Marqueurs ---------------------------------------------------------- */
  .map__markers {
    position: absolute;
    inset: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marker {
    position: absolute;
    transform: translate(-50%, -100%);
  }
  .marker__hit {
    position: relative;
    display: block;
    width: 30px;
    height: 40px;
    color: var(--terracotta);
  }
  .marker__pin {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    width: 26px;
    height: 26px;
    background: var(--terracotta);
    border: 3px solid var(--paper);
    border-radius: 50% 50% 50% 0;
    rotate: -45deg;
    box-shadow: var(--shadow-md);
    display: grid;
    place-items: center;
    transition: transform var(--transition), background var(--transition);
    z-index: 2;
  }
  .marker__index {
    rotate: 45deg;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
  }
  /* Halo discret sous le pin */
  .marker__pulse {
    position: absolute;
    left: 50%;
    top: 13px;
    width: 10px;
    height: 10px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--terracotta);
    opacity: 0.35;
    z-index: 1;
    animation: pulse 2.8s ease-out infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(209, 80, 0, 0.35);
    }
    70% {
      box-shadow: 0 0 0 16px rgba(209, 80, 0, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(209, 80, 0, 0);
    }
  }

  .marker__hit:hover .marker__pin,
  .marker__hit:focus-visible .marker__pin {
    transform: translateX(-50%) scale(1.18);
    background: var(--terracotta-dark);
  }

  /* Infobulle ---------------------------------------------------------- */
  .marker__tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%) translateY(6px);
    width: max-content;
    max-width: 240px;
    background: var(--green-900);
    color: #fff;
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition), transform var(--transition),
      visibility var(--transition);
    pointer-events: none;
    z-index: 5;
    text-align: left;
  }
  .marker__tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 7px solid transparent;
    border-top-color: var(--green-900);
  }
  .marker__name {
    display: block;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .marker__summary {
    display: block;
    font-size: 0.78rem;
    color: var(--beige-200);
    margin-top: 0.15rem;
    line-height: 1.4;
  }
  .marker__hit:hover .marker__tooltip,
  .marker__hit:focus-visible .marker__tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
</style>
