---
import type { ImageMetadata } from 'astro';
import { getPartners } from '../lib/partners';
import { SITE } from '../lib/site';
const partners = getPartners();
const year = new Date().getFullYear();

const imgSrc = (img: ImageMetadata | string) =>
  typeof img === 'string' ? img : img.src;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <strong>{SITE.title}</strong>
      <p>{SITE.tagline}</p>
      <a
        class="site-footer__insta"
        href={SITE.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Instagram ${SITE.instagram.handle} (nouvel onglet)`}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2 12c0-4.714 0-7.071 1.464-8.536C4.93 2 7.286 2 12 2s7.071 0 8.535 1.464C22 4.93 22 7.286 22 12s0 7.071-1.465 8.535C19.072 22 16.714 22 12 22s-7.071 0-8.536-1.465C2 19.072 2 16.714 2 12Z"
          />
          <circle
            cx="12"
            cy="12"
            r="4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
          <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" />
        </svg>
        <span>{SITE.instagram.handle}</span>
      </a>
    </div>

    {
      partners.length > 0 && (
        <div class="site-footer__partners">
          <span class="site-footer__label">Nos partenaires</span>
          <div class="site-footer__logos">
            {partners.map((p) =>
              p.href ? (
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${p.name} (nouvel onglet)`}
                >
                  <img src={imgSrc(p.img)} alt={`Logo — ${p.name}`} />
                </a>
              ) : (
                <img src={imgSrc(p.img)} alt={`Logo — ${p.name}`} />
              ),
            )}
          </div>
        </div>
      )
    }
  </div>
  <div class="site-footer__bar">
    <div class="container">
      <span>© {year} — Projet documentaire agroécologie · Cuba</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: var(--green-accent);
    color: var(--beige-100);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 2.5rem;
  }
  .site-footer__brand strong {
    color: #fff;
    font-size: 1.1rem;
  }
  .site-footer__brand p {
    margin: 0.3rem 0 0;
    color: var(--beige-300);
    max-width: 42ch;
  }
  .site-footer__insta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.9rem;
    color: var(--beige-100);
    font-weight: 600;
    font-size: 0.92rem;
    transition: color var(--transition);
  }
  .site-footer__insta:hover {
    color: #fff;
  }
  .site-footer__label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--terracotta-soft);
    margin-bottom: 0.6rem;
  }
  .site-footer__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .site-footer__logos img {
    height: 44px;
    width: auto;
    background: var(--beige-50);
    border-radius: 8px;
    padding: 4px 8px;
  }
  .site-footer__bar {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 1rem;
    font-size: 0.85rem;
    color: var(--beige-300);
  }
</style>
