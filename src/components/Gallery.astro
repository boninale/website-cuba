---
import { Image, getImage } from 'astro:assets';
import type { FarmMedia } from '../lib/images';

/**
 * Galerie photo/vidéo.
 * - Miniatures dans un ruban à défilement lent automatique (pause au survol).
 *   Les vidéos affichent une image d'aperçu + un badge « lecture ».
 * - Clic : ouverture plein écran (lightbox) — image ou lecteur vidéo.
 * - Légendes générées automatiquement depuis le nom de fichier.
 */
interface Props {
  media: FarmMedia[];
  group: string;
}
const { media, group } = Astro.props;

// Données pour la lightbox : URL haute résolution (image) ou URL vidéo.
const lightboxData = await Promise.all(
  media.map(async (m) => {
    if (m.type === 'image') {
      const full = (await getImage({ src: m.src, width: 1800, format: 'webp' }))
        .src;
      return { type: 'image', full, caption: m.caption };
    }
    return { type: 'video', full: m.src, caption: m.caption };
  }),
);

// On duplique la liste pour un défilement en boucle continue et fluide.
const loop = media.length > 2 ? [...media, ...media] : media;
---

{
  media.length > 0 && (
    <section class="gallery" aria-label="Galerie photo et vidéo">
      <div class="gallery__viewport">
        <ul
          class="gallery__track"
          style={`--count:${loop.length}`}
          data-gallery-track
        >
          {loop.map((m, i) => {
            const index = i % media.length;
            const label =
              m.type === 'video'
                ? `Lire la vidéo : ${m.caption}`
                : `Agrandir : ${m.caption}`;
            return (
              <li class="gallery__item">
                <button
                  type="button"
                  class="gallery__btn"
                  data-lb-open
                  data-lb-group={group}
                  data-lb-index={index}
                  aria-label={label}
                >
                  {m.type === 'image' ? (
                    <Image
                      src={m.src}
                      alt={m.caption}
                      widths={[300, 500]}
                      sizes="300px"
                      loading="lazy"
                    />
                  ) : (
                    <>
                      <video
                        class="gallery__video"
                        src={`${m.src}#t=0.5`}
                        muted
                        playsinline
                        preload="metadata"
                        tabindex="-1"
                      />
                      <span class="gallery__play" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="26" height="26">
                          <path fill="currentColor" d="M8 5v14l11-7z" />
                        </svg>
                      </span>
                    </>
                  )}
                  <span class="gallery__caption">{m.caption}</span>
                </button>
              </li>
            );
          })}
        </ul>
      </div>
      <script
        type="application/json"
        data-lb-data={group}
        set:html={JSON.stringify(lightboxData)}
      />
    </section>
  )
}

<style>
  .gallery {
    margin-block: 1.5rem;
  }
  .gallery__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 4%,
      #000 96%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 4%,
      #000 96%,
      transparent
    );
  }
  .gallery__track {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
    width: max-content;
    animation: scroll calc(var(--count) * 5s) linear infinite;
  }
  .gallery__track:hover,
  .gallery__track:focus-within {
    animation-play-state: paused;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery__track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
    }
  }

  .gallery__item {
    flex: none;
  }
  .gallery__btn {
    position: relative;
    display: block;
    width: 260px;
    height: 190px;
    padding: 0;
    border: none;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
    background: var(--beige-200);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .gallery__btn:hover,
  .gallery__btn:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .gallery__btn :global(img),
  .gallery__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Badge « lecture » sur les vignettes vidéo */
  .gallery__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(44, 61, 38, 0.55);
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    padding-left: 3px;
    transition: transform var(--transition), background var(--transition);
  }
  .gallery__btn:hover .gallery__play,
  .gallery__btn:focus-visible .gallery__play {
    transform: scale(1.08);
    background: var(--terracotta);
  }
  .gallery__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.4rem 0.75rem 0.6rem;
    font-size: 0.82rem;
    color: #fff;
    text-align: left;
    background: linear-gradient(transparent, rgba(44, 61, 38, 0.82));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--transition), transform var(--transition);
  }
  .gallery__btn:hover .gallery__caption,
  .gallery__btn:focus-visible .gallery__caption {
    opacity: 1;
    transform: translateY(0);
  }
</style>
