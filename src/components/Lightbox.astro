---
import Icon from './Icon.astro';

/**
 * Lightbox partagée (une seule par page).
 * Ouvre n'importe quelle galerie déclarée via des boutons `[data-lb-open]`
 * (attributs `data-lb-group` + `data-lb-index`) et les données JSON associées
 * (`<script data-lb-data="group">`).
 *
 * Fonctionnalités : plein écran, navigation clavier (←/→/Échap), navigation
 * tactile (glissement), légendes.
 */
---

<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Image en plein écran"
  hidden
>
  <button class="lightbox__close" data-lb-close aria-label="Fermer">
    <Icon name="x" size={26} />
  </button>
  <button class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Image précédente">
    <Icon name="chevron-left" size={30} />
  </button>
  <button class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Image suivante">
    <Icon name="chevron-right" size={30} />
  </button>

  <figure class="lightbox__figure">
    <img class="lightbox__img" data-lb-img src="" alt="" />
    <figcaption class="lightbox__caption" data-lb-caption></figcaption>
  </figure>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: rgba(24, 32, 20, 0.92);
    backdrop-filter: blur(4px);
    padding: clamp(1rem, 4vw, 3rem);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox.is-open {
    opacity: 1;
  }
  .lightbox__figure {
    margin: 0;
    max-width: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .lightbox__img {
    max-width: min(1400px, 92vw);
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: var(--shadow-lg);
    background: #0002;
    touch-action: pan-y;
    user-select: none;
  }
  .lightbox__caption {
    color: var(--beige-100);
    font-size: 0.95rem;
    text-align: center;
    max-width: 60ch;
  }
  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    cursor: pointer;
    transition: background var(--transition), transform var(--transition);
  }
  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: rgba(255, 255, 255, 0.24);
  }
  .lightbox__close {
    top: clamp(0.75rem, 3vw, 1.5rem);
    right: clamp(0.75rem, 3vw, 1.5rem);
  }
  .lightbox__nav--prev {
    left: clamp(0.5rem, 3vw, 1.5rem);
  }
  .lightbox__nav--next {
    right: clamp(0.5rem, 3vw, 1.5rem);
  }
  .lightbox__nav:hover {
    transform: scale(1.06);
  }
  @media (max-width: 600px) {
    .lightbox__nav {
      bottom: clamp(0.75rem, 4vw, 1.5rem);
      top: auto;
    }
    .lightbox__nav--prev {
      left: 25%;
    }
    .lightbox__nav--next {
      right: 25%;
    }
  }
</style>

<script>
  interface Slide {
    full: string;
    caption: string;
  }

  function setupLightbox() {
    const box = document.getElementById('lightbox');
    if (!box) return;
    const imgEl = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const capEl = box.querySelector<HTMLElement>('[data-lb-caption]')!;

    const groups = new Map<string, Slide[]>();
    document.querySelectorAll<HTMLScriptElement>('[data-lb-data]').forEach((s) => {
      const group = s.dataset.lbData!;
      try {
        groups.set(group, JSON.parse(s.textContent || '[]'));
      } catch {
        groups.set(group, []);
      }
    });

    let current: Slide[] = [];
    let index = 0;
    let lastFocus: HTMLElement | null = null;

    const render = () => {
      const slide = current[index];
      if (!slide) return;
      imgEl.src = slide.full;
      imgEl.alt = slide.caption;
      capEl.textContent = slide.caption;
    };

    const open = (group: string, i: number) => {
      current = groups.get(group) || [];
      if (current.length === 0) return;
      index = ((i % current.length) + current.length) % current.length;
      lastFocus = document.activeElement as HTMLElement;
      render();
      box.hidden = false;
      requestAnimationFrame(() => box.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
      box.querySelector<HTMLButtonElement>('[data-lb-close]')?.focus();
    };

    const close = () => {
      box.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(() => {
        box.hidden = true;
        imgEl.src = '';
      }, 200);
      lastFocus?.focus();
    };

    const go = (dir: number) => {
      if (current.length === 0) return;
      index = (index + dir + current.length) % current.length;
      render();
    };

    // Ouverture depuis les vignettes
    document.querySelectorAll<HTMLElement>('[data-lb-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        open(btn.dataset.lbGroup!, Number(btn.dataset.lbIndex || 0));
      });
    });

    // Contrôles
    box.querySelector('[data-lb-close]')?.addEventListener('click', close);
    box.querySelector('[data-lb-prev]')?.addEventListener('click', () => go(-1));
    box.querySelector('[data-lb-next]')?.addEventListener('click', () => go(1));
    box.addEventListener('click', (e) => {
      if (e.target === box) close();
    });

    // Clavier
    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });

    // Tactile (glissement horizontal)
    let startX = 0;
    imgEl.addEventListener('touchstart', (e) => {
      startX = e.changedTouches[0].clientX;
    }, { passive: true });
    imgEl.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
    }, { passive: true });
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
