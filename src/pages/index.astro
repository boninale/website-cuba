---
import BaseLayout from '../layouts/BaseLayout.astro';
import CubaMap from '../components/CubaMap.astro';
import Icon from '../components/Icon.astro';
import { getFarms } from '../lib/farms';
import { SITE } from '../lib/site';

const farms = await getFarms();
---

<BaseLayout title="Accueil" active="/">
  <section class="home">
    <div class="home__intro container">
      <h1 class="home__title">{SITE.title}</h1>
      <p class="home__tagline">{SITE.tagline}</p>
      <p class="home__hint" aria-hidden="true">
        <Icon name="map-pin" size={16} />
        Survolez un marqueur pour un aperçu, cliquez pour ouvrir la fiche.
      </p>
    </div>

    <div class="home__map container">
      {
        farms.length > 0 ? (
          <CubaMap farms={farms} />
        ) : (
          <p class="home__empty">
            Aucune ferme n'a encore été ajoutée. Déposez un dossier dans
            <code>src/content/farms/</code> pour voir apparaître son marqueur.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - var(--header-height));
    padding-block: clamp(1.5rem, 4vh, 3rem) 2rem;
    background:
      radial-gradient(
        ellipse 80% 60% at 50% 0%,
        var(--beige-100),
        transparent 70%
      );
  }
  .home__intro {
    text-align: center;
    max-width: 720px;
  }
  .home__title {
    font-size: clamp(1.9rem, 5vw, 3rem);
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .home__tagline {
    color: var(--text-muted);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    margin: 0 auto;
    max-width: 46ch;
  }
  .home__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
  }
  .home__map {
    flex: 1;
    display: grid;
    place-items: center;
    padding-top: clamp(1rem, 3vh, 2.5rem);
    /* Conserve une bonne distance entre la carte et le pied de page. */
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }
  .home__empty {
    color: var(--text-muted);
    text-align: center;
  }
  .home__empty code {
    background: var(--beige-200);
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
  }
</style>
